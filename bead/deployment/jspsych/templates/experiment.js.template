/**
 * jsPsych 8.x Batch Experiment
 * Generated by bead deployment system
 *
 * Experiment: {{ title }}
 * Description: {{ description }}
 */

// Global variables
let distributor = null;
{% if result_stream %}
function createResultStream(append) {
    const local = [];
    const failed = [];
    let sequence = 0;
    let retries = 0;
    let delivered = 0;
    let pending = Promise.resolve();
    let closed = false;
    function record(recordType, fields) {
        if (closed) return;
        const entry = {
            ...fields,
            schema_version: "1.0",
            record_type: recordType,
            seq: sequence++,
            wall_ms: Date.now(),
            perf_ms: performance.now(),
        };
        if (!append) {
            local.push(entry);
            return;
        }
        const line = JSON.stringify(entry) + "\n";
        pending = pending.then(async () => {
            for (const delay of [0, 250, 1000]) {
                if (delay) {
                    retries++;
                    await new Promise(resolve => setTimeout(resolve, delay));
                }
                try {
                    await append(line);
                    delivered++;
                    if (delay && entry.record_type !== "event") {
                        record("event", { event: "append_retry_succeeded", prior_seq: entry.seq });
                    }
                    return;
                } catch {
                    // Try to deliver the identical line and sequence number again.
                }
            }
            failed.push(entry.seq);
        });
    }
    return {
        record,
        async finish(status) {
            let flushing;
            do {
                flushing = pending;
                await flushing;
            } while (flushing !== pending);
            record("end", {
                status, failed_seqs: [...failed],
                n_records_before_end: sequence,
                n_acknowledged: append ? delivered : null,
                n_retries: retries,
            });
            closed = true;
            await pending;
            return failed.length === 0;
        },
        records: () => structuredClone(local),
    };
}
{% endif %}

/**
 * Main experiment entry point.
 * Loads data, assigns list, and runs experiment.
 */
async function runExperiment() {
    try {
        const params = new URLSearchParams(
            {% if use_jatos %}jatos.urlQueryParameters ?? {% endif %}window.location.search
        );
        const sessionAdapter = {% if session_adapter %}BeadSessionAdapter{% else %}{}{% endif %};
        {% if result_stream %}
        const stream = createResultStream({% if use_jatos %}line => jatos.appendResultData(line){% else %}null{% endif %});
        {% if not use_jatos %}
        window.beadResultRecords = stream.records;
        {% endif %}
        const hashes = await fetch("data/build-hashes.json").then(r => r.json());
        const sessionEvents = new AbortController();
        {% endif %}
        const runtimeConfig = await fetch("data/config.json").then(r => r.json());
        let consented = {{ 'false' if consent_text else 'true' }};
        let withdrawn = false;
        let sessionStarted = false;
        let trialOnset = null;
        {% if slopit_enabled %}
        const captureLifetime = new AbortController();
        const captureConfig = {{ slopit_config | tojson }};
        if (captureConfig.profile === "response_controls" &&
            SlopitJsPsych.responseControlsSchemaVersion !== "1.0") {
            throw new Error("The packaged slopit bundle lacks response-controls schema 1.0.");
        }
        window.addEventListener("pagehide", () => captureLifetime.abort(), { once: true });
        {% endif %}

        // Load distribution config
        const distConfig = await fetch('data/distribution.json').then(r => r.json());

        // Load lists from JSONL
        const lists = await BeadLists.loadLists('data/lists.jsonl');

        // Load items from JSONL
        const items = await BeadLists.loadItems('data/items.jsonl');

        const requestedSeed = {% if not use_jatos or debug_mode or session_adapter %}params.get("seed"){% else %}null{% endif %};
        const hasRequestedSeed = requestedSeed && /^\d{1,10}$/.test(requestedSeed) && Number(requestedSeed) <= 4294967295;
        const seed = hasRequestedSeed ? Number(requestedSeed) : crypto.getRandomValues(new Uint32Array(1))[0];
        const seedSource = hasRequestedSeed ? "url" : "crypto";

        let listIndex;
        let listSource;
        if (sessionAdapter.assignList) {
            ({ index: listIndex, source: listSource } = await sessionAdapter.assignList(lists, seed));
        } else {
            {% if use_jatos %}
            distributor = new BeadLists.ListDistributor(distConfig, lists);
            listIndex = await distributor.initialize();
            listSource = "jatos";
            {% else %}
            const replayList = params.get("list");
            listIndex = replayList === null ? 0 : lists.findIndex(
                list => String(list.list_number) === replayList || list.id === replayList);
            listSource = replayList === null ? "default" : "url";
            {% endif %}
        }
        const assignedList = lists[listIndex];
        if (!assignedList) throw new Error("Unknown assigned list.");
        console.log("Assigned list:", assignedList.name, listIndex);

        // Initialize jsPsych
        const jsPsych = initJsPsych({
            display_element: "jspsych-target",
            {% if slopit_enabled %}
            extensions: [
                { type: SlopitJsPsych.SlopitExtension }
            ],
            {% endif %}
            on_trial_start: function(trial) {
                {% if result_stream %}
                if (sessionStarted) {
                    trialOnset = { start_perf_ms: performance.now(), start_wall_ms: Date.now() };
                    const onset = trialOnset;
                    queueMicrotask(() => {
                        const display = jsPsych.getDisplayElement();
                        onset.onset_perf_ms = performance.now();
                        onset.onset_wall_ms = Date.now();
                        const canaries = [...display.querySelectorAll(".canary")];
                        const originallyHidden = canaries.map(node => node.hidden);
                        canaries.forEach(node => { node.hidden = true; });
                        onset.display_text = display.innerText;
                        canaries.forEach((node, index) => { node.hidden = originallyHidden[index]; });
                        onset.canary_text = canaries.map(node => node.textContent.trim()).join(" ") || null;
                        requestAnimationFrame(time => { onset.onset_frame_perf_ms = time; });
                    });
                }
                {% endif %}
            },
            {% if result_stream %}
            on_data_update: function(data) {
                if (!sessionStarted || !trialOnset || !consented) return;
                stream.record("trial", {
                    ...data,
                    ...trialOnset,
                    offset_perf_ms: performance.now(),
                    offset_wall_ms: Date.now(),
                });
                trialOnset = null;
            },
            {% endif %}
            on_finish: async function() {
                document.querySelector(".bead-withdraw")?.remove();
                {% if slopit_enabled %}
                captureLifetime.abort();
                {% endif %}
                {% if result_stream %}
                sessionEvents.abort();
                const delivered = sessionStarted ? await stream.finish(withdrawn ? "withdrawn" : "completed") : true;
                {% endif %}
                {% if use_jatos %}
                if (!consented || withdrawn) {
                    await jatos.endStudy(false);
                    return;
                }
                try {
                    {% if result_stream %}
                    if (!delivered) throw new Error("Some result records could not be delivered.");
                    {% else %}
                    await jatos.submitResultData(jsPsych.data.get().json());
                    {% endif %}
                    if (distributor) await distributor.markCompleted();
                    {% if on_finish_url %}
                    await jatos.endStudyAndRedirect({{ on_finish_url | tojson }});
                    {% else %}
                    await jatos.endStudy(true);
                    {% endif %}
                } catch (error) {
                    console.error("Failed to submit data:", error);
                    await jatos.endStudy(false);
                }
                {% elif on_finish_url %}
                if (consented && !withdrawn) window.location.href = {{ on_finish_url | tojson }};
                {% endif %}
            },
            show_progress_bar: {{ 'true' if show_progress_bar else 'false' }},
            auto_update_progress_bar: {{ 'true' if show_progress_bar else 'false' }}
        });

        {% if use_jatos %}
        // Add JATOS metadata
        jsPsych.data.addProperties({
            experiment_title: "{{ title }}",
            participant_id: jatos.urlQueryParameters.PROLIFIC_PID || jatos.workerId,
            prolific_pid: jatos.urlQueryParameters.PROLIFIC_PID || null,
            prolific_study_id: jatos.urlQueryParameters.STUDY_ID || null,
            prolific_session_id: jatos.urlQueryParameters.SESSION_ID || null,
            jatos_worker_id: jatos.workerId,
            jatos_study_result_id: jatos.studyResultId,
            jatos_component_result_id: jatos.componentResultId,
            assigned_list_index: listIndex,
            list_source: listSource,
            assigned_list_name: assignedList.name,
            assigned_list_id: assignedList.id,
            experiment_start_time: new Date().toISOString(),
        });
        {% else %}
        jsPsych.data.addProperties({
            experiment_title: "{{ title }}",
            assigned_list_index: listIndex,
            list_source: listSource,
            assigned_list_name: assignedList.name,
            assigned_list_id: assignedList.id,
            experiment_start_time: new Date().toISOString(),
        });
        {% endif %}

        jsPsych.randomization.setSeed(String(seed));
        jsPsych.data.addProperties({ seed, seed_source: seedSource });

        // Build timeline
        const timeline = [...(sessionAdapter.beforeConsent?.() ?? [])];
        {% if consent_text %}
        timeline.push({
            type: jsPsychHtmlButtonResponse,
            stimulus: {{ consent_text | tojson }},
            choices: ["I consent", "I do not consent"],
            on_finish(data) {
                consented = data.response === 0;
                if (!consented) {
                    jsPsych.abortExperiment("<p>You declined to participate.</p>");
                    return;
                }
                startSession();
            },
        });
        {% endif %}

        // Demographics form (if enabled, appears before instructions)
        {% if demographics_enabled %}
        timeline.push({
            type: jsPsychSurvey,
            title: "{{ demographics_title }}",
            pages: [
                [
                    {% for field in demographics_fields %}
                    {
                        name: "{{ field.name }}",
                        prompt: "{{ field.label }}",
                        required: {{ 'true' if field.required else 'false' }},
                        {% if field.field_type == 'text' %}
                        type: 'text'{% if field.placeholder %},
                        placeholder: "{{ field.placeholder }}"{% endif %}
                        {% elif field.field_type == 'number' %}
                        type: 'text',
                        input_type: 'number'{% if field.range_min is defined %},
                        min: {{ field.range_min }},
                        max: {{ field.range_max }}{% endif %}{% if field.placeholder %},
                        placeholder: "{{ field.placeholder }}"{% endif %}
                        {% elif field.field_type == 'dropdown' %}
                        type: 'drop-down',
                        options: {{ field.options | tojson }}
                        {% elif field.field_type == 'radio' %}
                        type: 'multi-choice',
                        options: {{ field.options | tojson }}
                        {% elif field.field_type == 'checkbox' %}
                        type: 'multi-select',
                        options: {{ field.options | tojson }}
                        {% endif %}
                    }{% if not loop.last %},{% endif %}
                    {% endfor %}
                ]
            ],
            button_label_finish: "{{ demographics_submit_text }}",
            data: {
                trial_type: 'demographics'
            }
        });
        {% endif %}

        // Instructions
        {% if instructions_is_multi_page %}
        // Multi-page instructions using jsPsych instructions plugin
        timeline.push({
            type: jsPsychInstructions,
            pages: [
                {% for page in instructions_pages %}
                `<div class="instructions-page">
                    {% if page.title %}<h2>{{ page.title }}</h2>{% endif %}
                    <div>{{ page.content }}</div>
                    {% if instructions_show_page_numbers and instructions_pages|length > 1 %}
                    <p class="page-number">Page {{ loop.index }} of {{ instructions_pages|length }}</p>
                    {% endif %}
                </div>`{% if not loop.last %},{% endif %}
                {% endfor %}
            ],
            show_clickable_nav: true,
            allow_backward: {{ 'true' if instructions_allow_backwards else 'false' }},
            button_label_next: "{{ instructions_button_next }}",
            button_label_previous: "Previous",
            button_label_finish: "{{ instructions_button_finish }}",
            data: {
                trial_type: 'instructions'
            }
        });
        {% elif instructions %}
        // Simple single-page instructions
        timeline.push({
            type: jsPsychHtmlKeyboardResponse,
            stimulus: `
                <div class="instructions">
                    <h2>Instructions</h2>
                    <p>{{ instructions }}</p>
                    <p><em>Press any key to continue</em></p>
                </div>
            `,
            data: {
                trial_type: 'instructions'
            }
        });
        {% endif %}

        // Get items for assigned list
        const listItemIds = assignedList.item_refs;
        if (!listItemIds || listItemIds.length === 0) {
            throw new Error(
                `Assigned list '${assignedList.name}' has no items. ` +
                `Check that lists were created with items before generate().`
            );
        }

        // Look up items by UUID
        const listItems = listItemIds.map(itemId => {
            const item = items[itemId];
            if (!item) {
                throw new Error(
                    `Item ${itemId} referenced in list '${assignedList.name}' not found in items.jsonl. ` +
                    `Verify all items were serialized correctly.`
                );
            }
            return item;
        });

        // Load pre-generated trials for this list
        const trialsData = await fetch('data/trials.json').then(r => r.json());
        const trialDefinitions = trialsData[assignedList.id];
        const defaultOrder = trialDefinitions {% if randomize_trial_order %}&& jsPsych.randomization.shuffle(trialDefinitions){% endif %};
        const context = { seed, assignedList, listSource };
        const sessionPlan = sessionAdapter.plan?.(trialDefinitions, context) ?? { trials: defaultOrder };
        const listTrials = sessionPlan.trials;
        
        if (!listTrials || listTrials.length === 0) {
            throw new Error(
                `No trials found for list '${assignedList.name}' (id: ${assignedList.id}). ` +
                `Ensure trials were generated correctly.`
            );
        }

        // Map plugin name strings to actual plugin classes
        const pluginRegistry = {
            'bead-forced-choice': BeadForcedChoicePlugin,
            'bead-rating': BeadRatingPlugin,
            'bead-binary-choice': BeadBinaryChoicePlugin,
            'bead-slider-rating': BeadSliderRatingPlugin,
            'bead-cloze-multi': BeadClozeMultiPlugin,
            'bead-span-label': BeadSpanLabelPlugin,
            'bead-categorical': BeadCategoricalPlugin,
            'bead-magnitude': BeadMagnitudePlugin,
            'bead-free-text': BeadFreeTextPlugin,
            'bead-multi-select': BeadMultiSelectPlugin,
        };

        function startSession() {
            sessionStarted = true;
            const contextData = sessionAdapter.sessionData?.(context) ?? {};
            if (contextData.trialProperties) jsPsych.data.addProperties(contextData.trialProperties);
            {% if result_stream %}
            stream.record("session", {
                ...hashes,
                session_id: {% if use_jatos %}String(jatos.componentResultId){% else %}crypto.randomUUID(){% endif %},
                jspsych_version: jsPsych.version(),
                experiment: runtimeConfig.title,
                ...contextData.sessionProperties,
                ...sessionPlan.metadata,
                list: assignedList.list_number,
                list_id: assignedList.id,
                list_source: listSource,
                seed,
                seed_source: seedSource,
                {% if use_jatos %}
                prolific_pid: jatos.urlQueryParameters.PROLIFIC_PID || null,
                jatos_worker_id: jatos.workerId,
                jatos_study_result_id: jatos.studyResultId,
                jatos_component_result_id: jatos.componentResultId,
                {% endif %}
            });
            stream.record("plan", { n_trials: listTrials.length, trials: listTrials });
            {% endif %}

            {% if consent_text %}
            const withdraw = document.createElement("button");
            withdraw.type = "button";
            withdraw.textContent = "Withdraw from study";
            withdraw.className = "bead-withdraw";
            withdraw.addEventListener("click", () => {
                withdrawn = true;
                consented = false;
                {% if slopit_enabled %}
                captureLifetime.abort();
                {% endif %}
                withdraw.remove();
                {% if result_stream %}
                stream.record("event", { event: "withdrawal" });
                {% endif %}
                jsPsych.abortExperiment("<p>You withdrew from the study.</p>");
            }, { once: true });
            document.body.append(withdraw);
            {% endif %}
            {% if result_stream %}
            const options = { signal: sessionEvents.signal };
            window.addEventListener("pagehide", (event) => stream.record("event", {
                event: "pagehide", trusted: event.isTrusted, persisted: event.persisted,
            }), { ...options, once: true });
            for (const type of ["blur", "focus"]) {
                window.addEventListener(type, event => stream.record("event", {
                    event: type, trusted: event.isTrusted,
                }), options);
            }
            document.addEventListener("visibilitychange", event => stream.record("event", {
                event: "visibilitychange",
                trusted: event.isTrusted,
                visibility_state: document.visibilityState,
            }), options);
            {% endif %}
        }
        timeline.push(...(sessionAdapter.beforeTrials?.(context) ?? []));
        // Add pre-generated trials to timeline, resolving plugin types
        for (const [planIndex, trial] of listTrials.entries()) {
            const pluginClass = pluginRegistry[trial.type];
            if (!pluginClass) {
                throw new Error(
                    `Unknown plugin type: "${trial.type}". ` +
                    `Available: ${Object.keys(pluginRegistry).join(', ')}`
                );
            }
            const node = {
                ...trial,
                type: pluginClass,
                data: { ...trial.data, plan_index: planIndex, list_number: assignedList.list_number },
            };
            sessionAdapter.configureTrial?.(node, context);
            {% if slopit_enabled %}
            const targetSelector = captureConfig.target_selectors[trial.data?.task_type] ??
                captureConfig.target_selectors[trial.type] ??
                captureConfig.target_selectors[runtimeConfig.experiment_type];
            if (targetSelector) {
                node.extensions = [{
                    type: SlopitJsPsych.SlopitExtension,
                    params: captureConfig.profile === "response_controls" ?
                        { responseControls: { targetSelector, hasConsent: () => consented, signal: captureLifetime.signal } } :
                        {
                            targetSelector,
                            keystroke: captureConfig.keystroke,
                            focus: captureConfig.focus,
                            paste: captureConfig.paste,
                        },
                }];
            }
            {% endif %}
            timeline.push(node);
            timeline.push(...(sessionAdapter.afterTrial?.(node, context) ?? []));
        }
        timeline.push(...(sessionAdapter.afterTrials?.(context) ?? []));

        // Completion
        timeline.push({
            type: jsPsychHtmlKeyboardResponse,
            stimulus: `
                <div class="completion">
                    <h2>✓ Complete</h2>
                    <p>Thank you for participating!</p>
                    <p>Your responses have been recorded.</p>
                    {% if on_finish_url %}
                    <p><em>You will be redirected shortly...</em></p>
                    {% else %}
                    <p><em>You may close this window.</em></p>
                    {% endif %}
                </div>
            `,
            choices: "NO_KEYS",
            trial_duration: 800,
            data: {
                trial_type: 'completion'
            }
        });

        // Run experiment
        {% if not consent_text %}
        startSession();
        {% endif %}
        await jsPsych.run(timeline);

    } catch (error) {
        console.error('Experiment error:', error);
        document.body.innerHTML = `
            <div style="max-width: 600px; margin: 100px auto; padding: 20px; border: 2px solid #d00; background: #fee;">
                <h2>Experiment Error</h2>
                <p><strong>Error:</strong> ${error.message}</p>
                <p>Please contact the experiment administrator.</p>
                <pre style="background: #fff; padding: 10px; overflow: auto;">${error.stack}</pre>
            </div>
        `;
    }
}

{% if use_jatos %}
// Wait for JATOS to load
jatos.onLoad(() => {
    runExperiment();
});
{% else %}
// Run immediately
runExperiment();
{% endif %}
